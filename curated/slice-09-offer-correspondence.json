  "canonical_offers": "curated/slice-09-jeba-definitive-totals.json: elections[].offers; all relation ids are year-local references to the exact JEBA list_id and label in that file",
  "relation_rule": {
    "declared_on": "2026-10-09",
    "interpretation": "Declared modelling prior before measurement, not measured ideology or voter transfers.",
    "municipal": "Continuation iff the same official registry id competes in both years.",
    "core": "PJ leads peronist fronts; absent PJ, use the front's member-party set. Cambiemos/JxC/Juntos core is PRO+UCR+CC-ARI (2015 UCR+CC-ARI documented); FIT core is PO+PTS+IS. Overlapping subsets of an absent-PJ front may support merge/split branches.",
    "minor": "Other shared provincial members are informational member_overlap entries, never coverage or continuity on their own; core branch support is not repeated as minor overlap.",
    "split": "Record destinations and shared core parties when a core divides; include additional shared members with each branch.",
    "brand": "Same-name alliance may continue when the destination includes the same-name party; this does not imply member-party carryover.",
    "unknown": "No source means exit/entry, indicating undocumented succession, not necessarily historical dissolution or creation.",
    "coverage": "Complete canonical coverage; repeated supported relations allowed; no exit/entry for supported offers. Multiple predecessor records require a merge containing all their origins.",
    "allocation": "Persistence allocation of split shares is deferred to a later frozen baseline rule; no allocation is declared here.",
    "sources": "Each supported relation cites both sides through the sources dictionary; parent visual verification is attributed, not worker refetch. sha256_prefix is the first 16 hex supplied by parent."
  },
