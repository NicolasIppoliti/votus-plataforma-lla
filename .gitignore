# Local AI runtime state
.atl/
.codegraph/
/odd/

# Local Impeccable installer footprints. Shared agent configuration stays trackable.
/.agents/skills/impeccable/
/.claude/skills/impeccable/
/.claude/agents/impeccable-*.md
/.claude/settings.local.json
/.codex/hooks.json
/.github/skills/impeccable/
/.github/agents/impeccable-*.agent.md
/.github/hooks/impeccable.json
/.opencode/skills/impeccable/
/.opencode/commands/impeccable.md

# Pi runtime state and optional locally installed skills are local by default.
# Keep the existing shared project configuration and Supabase skill links.
/.pi/*
!/.pi/gentle-ai/
/.pi/gentle-ai/*
!/.pi/gentle-ai/persona.json
!/.pi/skills/
/.pi/skills/*
!/.pi/skills/supabase
!/.pi/skills/supabase-postgres-best-practices

# Local Impeccable state. config.json remains eligible for review and tracking.
/.impeccable/config.local.json
/.impeccable/live/
/.impeccable/logs/
/.impeccable/cache/
/.impeccable/session/

# Machine-generated metadata and test/build artifacts.
.DS_Store
coverage/
.turbo/
.eslintcache
*.log
*.swp
*.swo

# Raw immutable archive (D2) — manifest-hashed; only the partido snapshot is versioned.
/archive/*
!/archive/geography/
/archive/geography/*
!/archive/geography/arba-coronel-rosales-partido.b502009185a5d6b1666312d2d91aa9b79053b2ee8a06f0aa683029b925c3ed13.geojson

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Node
node_modules/
.next/
apps/web/node_modules/
*.tsbuildinfo

# Env files with real secrets (never commit; see
# apps/web/environment-variables.example.txt for the placeholder template).
# Matched by prefix rather than by the three known suffixes: a real
# production credential landed in `.env.production-credentials`, which
# `.env`/`.env.local`/`.env.*.local` all failed to cover. The template is a
# `.txt`, so it stays visible.
.env
.env*
apps/web/e2e.env

# Vercel link state (project id / org id — machine local)
.vercel/

# Agent skills vendored by `vercel integration add` (regenerated on install)
apps/web/.agents/
apps/web/.claude/
apps/web/skills-lock.json

# Playwright run output
test-results/
apps/web/test-results/
apps/web/playwright-report/

# Playwright MCP session artifacts
.playwright-mcp/
