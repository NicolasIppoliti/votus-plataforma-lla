{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.x",
    "pnpm": "12.6.0"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm typecheck && pnpm build:next",
    "build:next": "node --experimental-strip-types ./scripts/production-build.ts",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node -e \"const v=require('@typescript/native').version;if(!/^7\\./.test(v))throw new Error('TypeScript 7.x required')\" && tsc --version && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:gate": "node --experimental-strip-types ./scripts/e2e-release-gate.ts",
    "test:e2e:focused": "node --experimental-strip-types ./scripts/e2e-release-gate.ts --focused",
    "verify:etl-isolated": "node --experimental-strip-types ./scripts/etl-verification.ts",
    "evaluate:territorial-renderer": "node --experimental-strip-types ./scripts/territorial-renderer-evaluation.ts"
  },
  "dependencies": {
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/maplibre": "9.4.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.48.0",
    "maplibre-gl": "6.10.0",
    "next": "16.3.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.6",
    "supabase": "2.116.0",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.2"
  }
}
