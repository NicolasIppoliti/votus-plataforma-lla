# e2e.env
# access-control / 14c, task 14.7: a credential-provisioning path for the
# LOCAL Supabase stack ONLY, committed on purpose.
#
# The anon and service-role keys below are NOT secrets: they are the fixed,
# well-known development defaults `supabase status` prints for EVERY local
# Supabase project (JWTs signed with the publicly documented local dev
# signing key, `iss: "supabase-demo"`, `exp` in the year 2032 -- the same
# values appear in Supabase's own quickstart docs and in every other
# project's local stack). Committing them exposes nothing; a real
# deployment never reads this file and never uses these keys (see
# `apps/web/environment-variables.example.txt` -- a real project's own
# secrets are supplied through the environment, never committed).
#
# Loaded by `apps/web/playwright.config.ts` via `process.loadEnvFile`
# (values already present in the environment always win -- Node's
# documented precedence -- so exporting real values still overrides this
# file for a run against a non-local stack). NOT loaded by `next dev`/
# `next build` (Next.js only auto-loads `.env`/`.env.local`/
# `.env.<NODE_ENV>[.local]` -- this plain, non-dotfile name matches none
# of those patterns), so this file affects Playwright runs only, never a
# normal `pnpm dev`. Named without a leading dot deliberately, so it is
# never mistaken for one of Next's own auto-loaded, normally-gitignored
# `.env*` files.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Only needed for e2e (Playwright) runs that seed a fixture auth user via
# the Supabase Admin API. Same "supabase-demo" local dev default as above.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Seeded/deleted automatically by `e2e/global-setup.ts` /
# `e2e/global-teardown.ts` (task 14.8). Local/ephemeral only -- not a real
# fiscal's credential.
VOTUS_E2E_TEST_USER_EMAIL=votus-e2e-fixture@example.test
VOTUS_E2E_TEST_USER_PASSWORD=votus-e2e-fixture-password-local-only
